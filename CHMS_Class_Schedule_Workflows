if(input.Schedule_Type != "Day")
{
	startDate = input.Start_Date.toDate();
	endDate = input.End_Date.toDate();
	// Extract the time string (e.g., "07:17:02 PM") from input.Start_Date so it can be combined with calculated dates
	inputTimeStr = input.Start_Date.toString("HH:mm:ss");
	// Map day name to day number (1: Sun, 2: Mon, 3: Tue, 4: Wed, 5: Thu, 6: Fri, 7: Sat)
	dayName = input.Held_On_Every_These_Day;
	targetDay = 1;
	if(dayName == "Sunday")
	{
		targetDay = 1;
	}
	else if(dayName == "Monday")
	{
		targetDay = 2;
	}
	else if(dayName == "Tuesday")
	{
		targetDay = 3;
	}
	else if(dayName == "Wednesday")
	{
		targetDay = 4;
	}
	else if(dayName == "Thursday")
	{
		targetDay = 5;
	}
	else if(dayName == "Friday")
	{
		targetDay = 6;
	}
	else if(dayName == "Saturday")
	{
		targetDay = 7;
	}
	// 1. WEEKLY SCHEDULE LOGIC
	if(input.Schedule_Type == "Weekly")
	{
		totalDays = startDate.daysBetween(endDate);
		count = 0;
		dummyText = "".leftpad(totalDays + 1);
		dummyList = dummyText.toList("");
		dayIndex = 0;
		for each  item in dummyList
		{
			currentDate = startDate.addDay(dayIndex);
			if(currentDate.getDayOfWeek() == targetDay)
			{
				count = count + 1;
			}
			dayIndex = dayIndex + 1;
		}
		countFinal = if(count > 3,count - 3,1);
		placeolderstring = leftpad(" ",countFinal);
		dlist = placeolderstring.replaceAll("",",").toList(",");
		runningDate = input.Start_Date;
		for each  final in dlist
		{
			runningDate = runningDate.nextWeekDay(dayName);
			if(runningDate <= endDate)
			{
				// Combine calculated date with the user-selected time string
				combinedDateTimeStr = runningDate.toString("yyyy-MM-dd") + " " + inputTimeStr;
				finalDateTime = combinedDateTimeStr.toDateTime("yyyy-MM-dd HH:mm:ss");
				add_rec = insert into Class_Schedule
				[
					Added_User=zoho.loginuser
					Grade=input.Grade
					Academic_Year=input.Academic_Year
					Teacher=input.Teacher
					Start_Date=finalDateTime
					Schedule_Name=input.Schedule_Name + " - " + runningDate.toString("dd MMM")
					End_Date=input.End_Date
					Schedule_Type=input.Schedule_Type
					Held_On_Every_These_Day=input.Held_On_Every_These_Day
					Status="New"
				];
			}
		}
		running_Date = input.Start_Date;
		input.Schedule_Name = input.Schedule_Name + " - " + running_Date.toString("dd MMM");
	}
	// 2. MONTHLY SCHEDULE LOGIC
	else if(input.Schedule_Type == "Monthly")
	{
		totalMonths = startDate.monthsDiff(endDate);
		countFinal = if(totalMonths > 0,totalMonths,1);
		placeolderstring = leftpad(" ",countFinal);
		dlist = placeolderstring.replaceAll("",",").toList(",");
		weekDaysList = {0,1,2,3,4,5,6};
		runningDate = startDate;
		for each  final in dlist
		{
			firstDayOfMonth = ("" + runningDate.getYear() + "-" + runningDate.getMonth() + "-01").toDate();
			firstOccurrence = null;
			for each  offset in weekDaysList
			{
				checkDate = firstDayOfMonth.addDay(offset);
				if(checkDate.getMonth() == firstDayOfMonth.getMonth() && checkDate.getDayOfWeek() == targetDay && firstOccurrence == null)
				{
					firstOccurrence = checkDate;
				}
			}
			if(firstOccurrence != null && firstOccurrence >= startDate && firstOccurrence <= endDate)
			{
				// Combine calculated date with the user-selected time string
				combinedDateTimeStr = firstOccurrence.toString("yyyy-MM-dd") + " " + inputTimeStr;
				finalDateTime = combinedDateTimeStr.toDateTime("yyyy-MM-dd HH:mm:ss");
				add_rec = insert into Class_Schedule
				[
					Added_User=zoho.loginuser
					Grade=input.Grade
					Academic_Year=input.Academic_Year
					Teacher=input.Teacher
					Start_Date=finalDateTime
					Schedule_Name=input.Schedule_Name + " - " + firstOccurrence.toString("dd MMM")
					End_Date=input.End_Date
					Schedule_Type=input.Schedule_Type
					Held_On_Every_These_Day=input.Held_On_Every_These_Day
					Status="New"
				];
			}
			runningDate = runningDate.addMonth(1);
		}
	}
	// 3. YEARLY SCHEDULE LOGIC
	else if(input.Schedule_Type == "Yearly")
	{
		loopCount = 12;
		placeolderstring = leftpad(" ",loopCount);
		dlist = placeolderstring.replaceAll("",",").toList(",");
		weekDaysList = {0,1,2,3,4,5,6};
		runningDate = startDate;
		for each  final in dlist
		{
			firstDayOfMonth = ("" + runningDate.getYear() + "-" + runningDate.getMonth() + "-01").toDate();
			firstOccurrence = null;
			for each  offset in weekDaysList
			{
				checkDate = firstDayOfMonth.addDay(offset);
				if(checkDate.getMonth() == firstDayOfMonth.getMonth() && checkDate.getDayOfWeek() == targetDay && firstOccurrence == null)
				{
					firstOccurrence = checkDate;
				}
			}
			if(firstOccurrence != null)
			{
				// Combine calculated date with the user-selected time string
				combinedDateTimeStr = firstOccurrence.toString("yyyy-MM-dd") + " " + inputTimeStr;
				finalDateTime = combinedDateTimeStr.toDateTime("yyyy-MM-dd HH:mm:ss");
				add_rec = insert into Class_Schedule
				[
					Added_User=zoho.loginuser
					Grade=input.Grade
					Academic_Year=input.Academic_Year
					Teacher=input.Teacher
					Start_Date=finalDateTime
					End_Date=input.End_Date
					Schedule_Type=input.Schedule_Type
					Held_On_Every_These_Day=input.Held_On_Every_These_Day
					Status="New"
					Schedule_Name=runningDate.toString("dd MMM")
				];
			}
			runningDate = runningDate.addMonth(1);
		}
	}
}
