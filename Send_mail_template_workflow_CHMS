Temp_type = Email_Template_Type[ID != null];
if(input.Student_Name == null)
{
	stud_email_list = Student_Academic_Enrollment[Academic_Year == input.Academic_Year && Grade == input.Grade].Student_Name.Email.getAll();
	if(input.Template_Type.Type_field == Temp_type.Type_field)
	{
		sendmail
		[
			from :zoho.adminuserid
			to :stud_email_list
			subject :input.Subject_field
			message :input.Template_Type.Template.replaceAll("$_message",input.Message,true)
		]
		info "students mails : " + stud_email_list; 
	}
// 	thisapp.Send_Mail(stud_email_list,input.Subject_field,input.Message,input.Academic_Year,input.Grade,input.Student_Name);
}
else
{
	mem_form = Members_Form[First_Name == input.Select_Student_Name.First_Name];
	stud_email = Student_Academic_Enrollment[Academic_Year == input.Academic_Year && Grade == input.Grade && Student_Name.First_Name == input.Select_Student_Name.First_Name];
	email = stud_email.Student_Name.Email;
	if(input.Template_Type.Type_field == Temp_type.Type_field)
	{
		sendmail
		[
			from :zoho.adminuserid
			to :email
			subject :input.Subject_field
			message :input.Template_Type.Template.replaceAll("$_message",input.Message,true)
		]
		info "Stud email : " + email;
	}
}

