void Send_Mails.send_mail(int academic_year, int grade, list student_email_ids, int student_name, string mail_sub, string mail_message, int template_id)
{
	temp_rec = Email_Template_Type[ID == template_id];
	template_code = temp_rec.Template;
	stud_email_list = Student_Academic_Enrollment[Academic_Year == academic_year && Grade == grade].Student_Name.Email.getAll();
	
	if(student_name != null)
	{
		info "1 Yes";
		student_rec = Student_Academic_Enrollment[ID == student_name];
		
		if(student_rec.ID != null)
		{
			info "1 Mail yes";
			
			first_name = student_rec.Student_Name.First_Name;
			email = student_rec.Student_Name.Email;
			
			formatted_template = template_code.replaceAll("Student", first_name, false).replaceAll("$_message", mail_message, true);
			
			sendmail
